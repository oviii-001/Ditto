{
  "name": "ditto-apk",
  "version": "0.1.0",
  "description": "Zero-clutter Android debug APK delivery automation for Google Antigravity & mobile developers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ditto": "./bin/ditto.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/postinstall.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "scripts/postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "antigravity",
    "android",
    "apk",
    "google-drive",
    "automation",
    "cli"
  ],
  "author": "Ditto Contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@googleapis/drive": "^27.0.0",
    "google-auth-library": "^11.3.2"
  }
}
